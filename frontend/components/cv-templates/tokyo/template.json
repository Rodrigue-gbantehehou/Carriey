      "userCanMove": true
    },
    {
      "type": "projects",
      "label": "Projets",
      "column": "right",
      "enabled": true,
      "userCanDisable": true,
      "userCanMove": true
    },
    {
      "type": "interests",
      "label": "Loisirs",
      "column": "left",
      "enabled": true,
      "userCanDisable": true,
      "userCanMove": true
