<div class="cv-container">


  <!-- Sidebar -->
  <aside class="left-column">
    {% set photo_section = template.sections | selectattr('type', 'equalto', 'photo') | list %}
    {% set is_photo_enabled = photo_section[0].enabled if photo_section else true %}
    {% if is_photo_enabled %}
    <div class="profile-photo-wrap">
      {% if data.profile.photo %}
      <div class="profile-photo">
        <img src="{{ data.profile.photo }}" alt="{{ data.profile.name | default('Photo') }}">
      </div>
      {% else %}
      <div class="photo-placeholder"><i class="fas fa-magic"></i></div>
      {% endif %}
    </div>
    {% endif %}

    {% for section in template.sections if section.enabled and section.column == 'left' %}
      {% if section.type == 'contact' %}
        <div class="sidebar-section">
          <h3 class="sidebar-title">{{ section.label | default('Connexion') }}</h3>
          <div class="contact-list">
            {% if data.profile.phone %}<div class="contact-item"><i class="fas fa-mobile-alt"></i><span>{{ data.profile.phone }}</span></div>{% endif %}
            {% if data.profile.email %}<div class="contact-item"><i class="fas fa-at"></i><span>{{ data.profile.email }}</span></div>{% endif %}
            {% if data.profile.location %}<div class="contact-item"><i class="fas fa-map-pin"></i><span>{{ data.profile.location }}</span></div>{% endif %}
          </div>
        </div>
      {% elif section.type == 'identity' %}
        {% if data.profile.age or data.profile.nationality or data.profile.marital_status %}
        <div class="sidebar-section">
          <h3 class="sidebar-title">{{ section.label | default('Perso') }}</h3>
          <div class="identity-list">
            {% if data.profile.age %}<div class="identity-item"><span class="identity-label">Âge</span><span>{{ data.profile.age }}</span></div>{% endif %}
            {% if data.profile.nationality %}<div class="identity-item"><span class="identity-label">Origine</span><span>{{ data.profile.nationality }}</span></div>{% endif %}
            {% if data.profile.marital_status %}<div class="identity-item"><span class="identity-label">Statut</span><span>{{ data.profile.marital_status }}</span></div>{% endif %}
          </div>
        </div>
        {% endif %}
      {% elif section.type == 'skills' and data.skills and data.skills.groups %}
        <div class="sidebar-section">
          <h3 class="sidebar-title">{{ section.label | default('Vibes / Tech') }}</h3>
          <div class="skills-wrap">
            {% for group in data.skills.groups %}
              {% for skill in group["items"] | default([]) %}
              <span class="skill-tag">{{ skill }}</span>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      {% elif section.type == 'languages' and data.languages %}
        <div class="sidebar-section">
          <h3 class="sidebar-title">{{ section.label | default('Langues') }}</h3>
          {% for lang in data.languages %}
          <div class="identity-item"><span class="identity-label">{{ lang.name }}</span><span>{{ lang.level }}</span></div>
          {% endfor %}
        </div>
      {% elif section.type.startswith('custom_') %}
        {% set custom_id = section.type.replace('custom_', '') %}
        {% for custom in data.custom_sections if custom.id == custom_id %}
          <div class="sidebar-section">
            <h3 class="sidebar-title">{{ custom.title }}</h3>
            <div style="font-size: 0.9em; line-height: 1.4; opacity: 0.9;">
              {% if custom.type == 'list' %}
                <ul style="list-style: none; padding: 0;">{% for item in custom.content.split('\n') if item.strip() %}<li style="margin-bottom: 4px;">• {{ item }}</li>{% endfor %}</ul>
              {% else %}
                {{ custom.content | replace('\n', '<br>') | safe }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </aside>

  <!-- Main Content -->
  <main class="right-column">
    <header class="header-meta">
      <h1 class="name">{{ data.profile.name | default('Nom Prénom') }}</h1>
      {% if data.profile.position or data.profile.title %}
      <p class="profession">{{ data.profile.position | default(data.profile.title) }}</p>
      {% endif %}
    </header>

    {% for section in template.sections if section.enabled and section.column != 'left' %}
      {% if section.type == 'summary' and data.summary %}
        <section class="content-section">
          <h3 class="section-title"><i class="fas fa-rocket"></i> {{ section.label | default('En Bref') }}</h3>
          <p class="about-text">{{ data.summary }}</p>
        </section>
      {% elif section.type == 'experience' and data.experience %}
        <section class="content-section">
          <h3 class="section-title"><i class="fas fa-bolt"></i> {{ section.label | default('Expériences') }}</h3>
          {% for exp in data.experience %}
          <div class="experience-item">
            <div class="exp-header">
              <h4 class="exp-title">{{ exp.position | default(exp.role) }}</h4>
              <span class="exp-date">{{ exp.dates | default((exp.start | default('')) ~ ' - ' ~ (exp.end | default('Présent'))) }}</span>
            </div>
            <div class="exp-company">{{ exp.company }}</div>
            {% if exp.tasks or exp.bullets %}
            <ul class="exp-tasks">{% for task in exp.tasks | default(exp.bullets) %}<li>{{ task }}</li>{% endfor %}</ul>
            {% endif %}
          </div>
          {% endfor %}
        </section>
      {% elif section.type == 'education' and data.education %}
        <section class="content-section">
          <h3 class="section-title"><i class="fas fa-brain"></i> {{ section.label | default('Études') }}</h3>
          <div class="education-grid">
            {% for edu in data.education %}
            <div class="edu-item">
              <div class="edu-degree">{{ edu.degree }}</div>
              <span class="edu-school">{{ edu.institution | default(edu.school) }}</span>
              <span class="edu-year">
                {% if edu.start or edu.end %}
                  {{ edu.start | default('') }}{{ ' - ' if edu.start and edu.end }}{{ edu.end | default('') }}
                {% else %}
                  {{ edu.dates | default(edu.year) }}
                {% endif %}
              </span>
            </div>
            {% endfor %}
          </div>
        </section>
      {% elif section.type == 'projects' and data.projects %}
        <section class="content-section">
          <h3 class="section-title"><i class="fas fa-lightbulb"></i> {{ section.label | default('Projets') }}</h3>
          {% for project in data.projects %}
          <div class="experience-item">
            <div class="exp-header"><h4 class="exp-title">{{ project.name }}</h4></div>
            {% if project.link %}<div class="exp-company">{{ project.link }}</div>{% endif %}
            <p class="about-text" style="margin-top: 5px;">{{ project.description }}</p>
          </div>
          {% endfor %}
        </section>
      {% elif section.type.startswith('custom_') %}
        {% set custom_id = section.type.replace('custom_', '') %}
        {% for custom in data.custom_sections if custom.id == custom_id %}
          <section class="content-section">
            <h3 class="section-title"><i class="fas fa-plus-circle"></i> {{ custom.title }}</h3>
            <div class="about-text">
              {% if custom.type == 'list' %}
                <ul class="exp-tasks">{% for item in custom.content.split('\n') if item.strip() %}<li>{{ item }}</li>{% endfor %}</ul>
              {% else %}
                {{ custom.content | replace('\n', '<br>') | safe }}
              {% endif %}
            </div>
          </section>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </main>
</div>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
