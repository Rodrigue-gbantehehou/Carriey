<div class="cv-container">


  <!-- Sidebar -->
  <aside class="sidebar">
    <!-- Profile Section (Fixed) -->
    <div class="profile-section">
      {% set photo_section = template.sections | selectattr('type', 'equalto', 'photo') | list %}
      {% set is_photo_enabled = photo_section[0].enabled if photo_section else true %}
      {% if is_photo_enabled %}
      {% if data.profile.photo %}
      <div class="profile-image">
        <img src="{{ data.profile.photo }}" alt="{{ data.profile.name | default('Photo') }}">
      </div>
      {% else %}
      <div class="photo-placeholder">
        <i class="fas fa-user"></i>
      </div>
      {% endif %}
      {% endif %}
      <h1 class="name">{{ data.profile.name | default('Nom Prénom') }}</h1>
      {% if data.profile.position or data.profile.title %}
      <p class="tagline">{{ data.profile.position | default(data.profile.title) }}</p>
      {% endif %}
    </div>

    <!-- Dynamic Sidebar Sections -->
    {% for section in template.sections %}
    {% if section.enabled and section.column == 'left' %}
      {% if section.type == 'contact' %}
        <div class="sidebar-info">
          <h3 class="sidebar-title">{{ section.label | default('Contact') }}</h3>
          <div class="contact-list">
            {% if data.profile.phone %}<div class="contact-item"><i class="fas fa-phone"></i><span>{{ data.profile.phone }}</span></div>{% endif %}
            {% if data.profile.email %}<div class="contact-item"><i class="fas fa-envelope"></i><span>{{ data.profile.email }}</span></div>{% endif %}
            {% if data.profile.location %}<div class="contact-item"><i class="fas fa-map-marker-alt"></i><span>{{ data.profile.location }}</span></div>{% endif %}
          </div>
        </div>
      {% elif section.type == 'skills' and data.skills and data.skills.groups %}
        <div class="sidebar-info">
          <h3 class="sidebar-title">{{ section.label | default('Compétences') }}</h3>
          <div class="skills-wrap">
            {% for group in data.skills.groups %}
              {% for skill in group["items"] | default([]) %}
              <span class="skill-tag">{{ skill }}</span>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      {% elif section.type == 'languages' and data.languages %}
        <div class="sidebar-info">
          <h3 class="sidebar-title">{{ section.label | default('Langues') }}</h3>
          <div class="languages-list">
            {% for lang in data.languages %}
            <div class="language-item">
              <span class="language-name">{{ lang.name }}</span>
              <span class="language-level">{{ lang.level }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      {% elif section.type.startswith('custom_') %}
        {% set custom_id = section.type.replace('custom_', '') %}
        {% for custom in data.custom_sections if custom.id == custom_id %}
          <div class="sidebar-info">
            <h3 class="sidebar-title">{{ custom.title }}</h3>
            <div class="summary-text" style="font-size: 0.9em; opacity: 0.9;">
              {% if custom.type == 'list' %}
                <ul style="list-style: none; padding: 0;">
                {% for item in custom.content.split('\n') if item.strip() %}
                  <li style="margin-bottom: 4px;">• {{ item }}</li>
                {% endfor %}
                </ul>
              {% else %}
                {{ custom.content | replace('\n', '<br>') | safe }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    {% endif %}
    {% endfor %}
  </aside>
  
  <!-- Main Content -->
  <main class="main-content">
    {% for section in template.sections %}
    {% if section.enabled and (section.column != 'left') %}
      {% if section.type == 'summary' and data.summary %}
        <section class="section">
          <h2 class="section-title">{{ section.label | default('Profil') }}</h2>
          <div class="summary-text"><p>{{ data.summary }}</p></div>
        </section>
      {% elif section.type == 'experience' and data.experience %}
        <section class="section">
          <h2 class="section-title">{{ section.label | default('Expérience') }}</h2>
          {% for exp in data.experience %}
          <div class="experience-item">
            <div class="item-header">
              <div>
                <div class="item-title">{{ exp.position | default(exp.role) }}</div>
                <div class="item-company">{{ exp.company }}</div>
              </div>
              <div class="item-date">{{ exp.dates | default((exp.start | default('')) ~ ' – ' ~ (exp.end | default('Présent'))) }}</div>
            </div>
            {% if exp.tasks or exp.bullets %}
            <div class="item-description">
              <ul class="exp-tasks">
                {% for task in exp.tasks | default(exp.bullets) %}<li>{{ task }}</li>{% endfor %}
              </ul>
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </section>
      {% elif section.type == 'education' and data.education %}
        <section class="section">
          <h2 class="section-title">{{ section.label | default('Formation') }}</h2>
          {% for edu in data.education %}
          <div class="education-item">
            <div class="item-header">
              <div>
                <div class="item-title">{{ edu.degree }}</div>
                <div class="item-school">{{ edu.institution | default(edu.school) }}</div>
              </div>
              <div class="item-date">
                {% if edu.start or edu.end %}
                  {{ edu.start | default('') }}{{ ' - ' if edu.start and edu.end }}{{ edu.end | default('') }}
                {% else %}
                  {{ edu.dates | default(edu.year) }}
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </section>
      {% elif section.type == 'projects' and data.projects %}
        <section class="section">
          <h2 class="section-title">{{ section.label | default('Projets') }}</h2>
          {% for project in data.projects %}
          <div class="experience-item">
            <div class="item-header">
              <div>
                <div class="item-title">{{ project.name }}</div>
                {% if project.link %}<div class="item-company">{{ project.link }}</div>{% endif %}
              </div>
            </div>
            <div class="item-description"><p>{{ project.description }}</p></div>
          </div>
          {% endfor %}
        </section>
      {% elif section.type.startswith('custom_') %}
        {% set custom_id = section.type.replace('custom_', '') %}
        {% for custom in data.custom_sections if custom.id == custom_id %}
          <section class="section">
            <h2 class="section-title">{{ custom.title }}</h2>
            <div class="summary-text">
              {% if custom.type == 'list' %}
                <ul class="exp-tasks">
                {% for item in custom.content.split('\n') if item.strip() %}
                  <li>{{ item }}</li>
                {% endfor %}
                </ul>
              {% else %}
                {{ custom.content | replace('\n', '<br>') | safe }}
              {% endif %}
            </div>
          </section>
        {% endfor %}
      {% endif %}
      {% endif %}
    {% endfor %}
  </main>
</div>
