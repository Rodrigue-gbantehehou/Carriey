# Configuration Backend O2Switch
ENVIRONMENT=production

# URLs de l'application
FRONTEND_URL=https://carriey.nomiks.net
BACKEND_CORS_ORIGINS=https://carriey.nomiks.net,https://carapi.nomiks.net

# ⚠️ OBLIGATOIRE - Base de données MySQL O2Switch
# Format : mysql+pymysql://USER:PASSWORD@localhost/NOM_DB
DATABASE_URL=mysql+pymysql://REMPLACER_USER:REMPLACER_PASSWORD@localhost/REMPLACER_DB

# ⚠️ OBLIGATOIRE - Clé secrète JWT (longue chaîne aléatoire)
JWT_SECRET_KEY=REMPLACER_PAR_UNE_CLE_SECRETE_TRES_LONGUE_ET_ALEATOIRE

# Paiements (optionnel)
# KKIAPAY_PUBLIC_KEY=...
# KKIAPAY_PRIVATE_KEY=...
# FEDAPAY_PUBLIC_KEY=...
# FEDAPAY_SECRET_KEY=...
