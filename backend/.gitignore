# 🧩 Ignorer les dépendances Node.js
/frontend/node_modules/

# 🔒 Ignorer les fichiers d'environnement (variables secrètes)
.env
.env.local
/frontend/.env
/frontend/.env.local

# 🐍 Ignorer l'environnement virtuel Python
/backend/.venv/

# 🗂️ Autres dossiers de cache (optionnel mais recommandé)
__pycache__/
*.pyc

# ?? Ignorer les uploads prives et les logs
/private_exports/
/private_uploads/
/logs/

# ?? Ignorer les medias generes ou uploades
/static/photos/
/app/core/static/previews/
_tmp_render_*.html
