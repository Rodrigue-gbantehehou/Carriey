# Database (TiDB Cloud URL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?ssl_ca=/etc/ssl/certs/ca-certificates.crt
DATABASE_URL=mysql+pymysql://root:@localhost:3306/carriey
APP_NAME=Carriey

# JWT
JWT_SECRET_KEY=votre_clé_secrète_très_longue_et_sécurisée_changez_moi_en_production

# KkiaPay Configuration
KKIAPAY_PUBLIC_KEY=your_public_key_here
KKIAPAY_PRIVATE_KEY=your_private_key_here
KKIAPAY_SECRET=your_webhook_secret_here
KKIAPAY_SANDBOX=true
KKIAPAY_API_URL=https://api-sandbox.kkiapay.me/api/v1

# FedaPay Configuration
FEDAPAY_PUBLIC_KEY=your_fedapay_public_key
FEDAPAY_SECRET_KEY=your_fedapay_secret_key
FEDAPAY_SANDBOX=true
FEDA_WEBHOOK_KEY=your_custom_webhook_secret_here

# Backend URL (pour callbacks)
BACKEND_URL=http://localhost:8000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# IA (Google Gemini recommandé ou Groq)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Microservice PDF
PDF_SERVICE_URL=https://carriey-pdf-service.onrender.com
PDF_SERVICE_SECRET=your_pdf_service_secret_here

