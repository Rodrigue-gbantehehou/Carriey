# =============================================================================
# CVTOR CONFIGURATION (PRODUCTION EXAMPLE)
# =============================================================================

# --- BACKEND (Render.com / TiDB) ---
# DATABASE_URL: mysql+pymysql://<user>:<pass>@<host>:<port>/<db>?ssl_ca=/etc/ssl/certs/ca-certificates.crt
DATABASE_URL=mysql+pymysql://user:password@host.tidbcloud.com:4000/cvtor?ssl_ca=/etc/ssl/certs/ca-certificates.crt

# Secret for JWT generation (Must be at least 32 chars)
SECRET_KEY=generate-a-very-long-and-secure-random-string-here

# Allowed origins for CORS (Add your Vercel URL here)
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://cvtor.vercel.app"]

# --- FRONTEND (Vercel) ---
# URL of your backend API (Points to Render.com URL)
NEXT_PUBLIC_API_URL=https://cvtor-backend.onrender.com/api

# Secret for NextAuth (Must be random string)
NEXTAUTH_SECRET=generate-another-long-secure-random-string

# URL of your frontend (Vercel URL)
NEXTAUTH_URL=https://cvtor.vercel.app

# --- SERVICES ---
# Hugging Face token for AI generation (Optional)
HF_TOKEN=hf_...

# Payment Keys (KkiaPay/FedaPay)
KKIAPAY_PUBLIC_KEY=997c4af0653011efbf02478c5adba4b8
KKIAPAY_PRIVATE_KEY=tpk_997c4af2653011efbf02478c5adba4b8
KKIAPAY_SECRET=tsk_997c4af3653011efbf02478c5adba4b8
KKIAPAY_SANDBOX=true

FEDAPAY_PUBLIC_KEY=pk_live_0tINtD6CDudtgmh16ZPPxgkc
